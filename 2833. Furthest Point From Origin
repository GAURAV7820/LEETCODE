class Solution {
public:
    int furthestDistanceFromOrigin(string moves) {
        int dist=0,flag=1;
        unordered_map<int,int>mp;
        for(auto m:moves){
            mp[m]++;
        }
        if(mp['L']>mp['R']){
            flag=-1;
        }
        for(auto m:moves){
            if(m=='L')
                dist-=1;
            else if(m=='R')
                dist+=1;
            else if(flag==-1)
                dist-=1;
            else
                dist+=1;
        }
        return abs(dist);
    }
};
