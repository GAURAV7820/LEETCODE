class Solution {
public:
    bool judgeCircle(string moves) {
        int x=0,y=0;
        for(auto m:moves){
            if(m=='U'){
                y++;
            }
            else if(m=='D'){
                y--;
            }
            else if(m=='R'){
                x++;
            }
            else{
                x--;
            }
        }
        if(x==0&&y==0)
            return true;
        else
            return false;
    }
};
