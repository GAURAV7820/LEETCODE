class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        vector<int>freq(k,0);
        freq[0]=1;
        int sum=0;
        int count=0;
        int rem;
        for(auto n:nums){
            sum+=n;
            rem=(((sum%k)+k)%k);
            count+=freq[rem];
            freq[rem]++;
        }
        return count;
    }
};
