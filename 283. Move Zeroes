class Solution {
public:
    void moveZeroes(vector<int>& nums) {
        int j=1;
        int i=0;
        for(int j=1;j<nums.size();j++){
            if(nums[i]!=0)
                i++;
            if(nums[j]!=0){
                if(nums[i]==0){
                    nums[i]=nums[j];
                    nums[j]=0;
                    i++;
                }
            }
        }
    }
};
