class Solution:
    def largestInteger(self, nums: List[int], k: int) -> int:
        mp={}
        for i in range(len(nums)-k+1):
            seen=set()

            for j in range(i,i+k):
                seen.add(nums[j])
            for x in seen:
                mp[x]=mp.get(x,0)+1
        ans=-1
        for x, count in mp.items():
            if count == 1:
                ans = max(ans, x)

        return ans
        
