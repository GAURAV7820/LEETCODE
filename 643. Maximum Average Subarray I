class Solution:
    def findMaxAverage(self, nums: List[int], k: int) -> float:
        left=0
        sum=0
        average=float('-inf')
        max_avg=float('-inf')
        for right in range(len(nums)):
            if right-left+1<k:
                sum+=nums[right]
            elif right-left+1==k:
                sum+=nums[right]
                average=sum/k
                sum-=nums[left]
                left+=1
            if max_avg<average:
                max_avg=average
        return max_avg
        
