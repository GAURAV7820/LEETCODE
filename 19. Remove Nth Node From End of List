/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
       ListNode* temp=head;
       int count=0;
       while(temp!=NULL){
        count++;
        temp=temp->next;
       }
       int it=count-n;
       int i=1;
       temp=head;
       if(it==0){
        head=head->next;
        delete temp;
        return head;
       }
       while(i!=it){
            temp=temp->next;
            i++;
       }
        ListNode* node = temp->next;
        temp->next = node->next;
        delete node;
        return head;
    }
};
