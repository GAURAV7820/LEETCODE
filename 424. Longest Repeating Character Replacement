class Solution {
public:
    int characterReplacement(string s, int k) {
        int len=0,freq=0,left=0,ans=0;
        unordered_map<char,int>mp;
        for(int i=0;i<s.size();i++){
                mp[s[i]]++;
                freq=max(freq,mp[s[i]]);
                while((i-left+1)-freq>k){
                    mp[s[left]]--;
                    left++;
                }
                ans=max(ans,i-left+1);
        }
        return ans;
    }
};
