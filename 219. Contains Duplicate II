class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
            unordered_set<int>st;
            int j=0;
            for(int i=0;i<nums.size();i++){
                if(i-j>k){
                    st.erase(nums[j]);
                    j++;
                }
                if(st.count(nums[i]))
                    return true;
                st.insert(nums[i]);
            }
            return false;
    }
};
