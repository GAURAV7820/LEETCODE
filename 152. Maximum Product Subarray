class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int maxnum=nums[0];
        int minnum=nums[0];
        int result=nums[0];
        for(int i=1;i<nums.size();i++){
            if(nums[i]<0)
                swap(maxnum,minnum);
            maxnum=max(nums[i],maxnum*nums[i]);
            minnum=min(nums[i],minnum*nums[i]);
            result=max(result,maxnum);
        }
        return result;
    }
};
