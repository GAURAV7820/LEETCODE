class Solution {
public:
    vector<string> getLongestSubsequence(vector<string>& words, vector<int>& groups) {
        for(int i=0,j=1;i<words.size()-1;i++,j++){
                    if(groups[i]==groups[j]){
                        words.erase(words.begin()+j);
                        groups.erase(groups.begin()+j);
                        i--;
                        j--;
                    }
        }
        return words;
    }
};
