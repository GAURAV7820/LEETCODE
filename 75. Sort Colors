class Solution {
public:
    void sortColors(vector<int>& nums) {
        int j,k,temp;
            int i=0;
            j=i;
            k=nums.size()-1;
            while(j<=k){
                if(nums[j]==0){
                    temp=nums[i];
                    nums[i]=nums[j];
                    nums[j]=temp;
                    j++;
                    i++;
                }
                else if(nums[j]==2){
                    temp=nums[k];
                    nums[k]=nums[j];
                    nums[j]=temp;
                    k--;
                }
                else{
                    j++;
                }

                
            }
    }
};
