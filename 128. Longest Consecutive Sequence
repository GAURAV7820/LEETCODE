class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        sort(nums.begin(),nums.end());
        int len=1,ans=1;
        for(int i=0;i<nums.size()-1;i++){
             if(nums.size()==0) return 0;
            if(nums[i+1]==nums[i]+1)
                len++;
            else if(nums[i+1]==nums[i])
                continue;
            else
                len=1;
            ans=max(ans,len);
        }
        return ans;
    }
};
