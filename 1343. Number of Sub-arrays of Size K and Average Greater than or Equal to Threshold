class Solution {
public:
    int numOfSubarrays(vector<int>& arr, int k, int threshold) {
        int left=0,sum=0,count=0;
        for(int right=0;right<arr.size();right++){
            if(right<k){
                sum+=arr[right];
            }
            else{
                if(sum/k>=threshold)
                    count++;
                sum-=arr[left++];
                sum+=arr[right];
            }
        }
        if(sum/k>=threshold)
                    count++;
        return count;
    }
};
