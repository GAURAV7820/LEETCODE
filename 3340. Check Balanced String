class Solution {
public:
    bool isBalanced(string num) {
        int evensum=0,oddsum=0;
        int n=num.size();
        for(int i=0;i<n;i++){
            int number=num[i]-'0';
            if(i%2==0)
                evensum+=number;
            else
                oddsum+=number;
        }
        return evensum==oddsum;
    }
};
