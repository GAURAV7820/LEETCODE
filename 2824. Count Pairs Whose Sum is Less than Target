class Solution {
public:
    int countPairs(vector<int>& nums, int target) {
        sort(nums.begin(),nums.end());
        int j=nums.size()-1,count=0,i=0;
        while(i<j){     
                    if(nums[i]+nums[j]<target){
                        count+=j-i;
                        i++;
                    }
                    else if(nums[i]+nums[j]>=target){
                        j--;
                    }
        }
        return count;
    }
};
