class Solution {
public:
    int minimumDeletions(string s) {
        int ans=0;
        int bcount=0;
        for(auto c:s){
            if(c=='b')
                bcount++;
            else
            ans=min(ans+1,bcount); //ya to a hatayenge ya to b jo bhi minimum ho
        }
        return ans;
    }
};
