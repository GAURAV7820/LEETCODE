class Solution {
public:
    int threeSumClosest(vector<int>& nums, int target) {
        int j,k,sum=1e9,temp,diff;
        sort(nums.begin(),nums.end());
      for(int i=0;i<nums.size()-2;i++){
        j=i+1;
        k=nums.size()-1;
        while(j<k){
            temp=nums[i]+nums[j]+nums[k];
            diff=abs(temp-target);
            if(temp>target){
                k--;
            }
            else{
                j++;
            }
            if(abs(sum-target)>diff)
                sum=temp;
        }
      }
      return sum;  
    }
};
